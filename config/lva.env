# Environment for linux-voice-assistant (read by systemd via EnvironmentFile).
# Copy of upstream .env.example values we pin. Adjust audio devices after
# first bring-up if the defaults do not match `arecord -L` output.

CLIENT_NAME="llm-module-satellite"
WAKE_MODEL="okay_nabu"
STOP_MODEL="stop"

# Audio: the Axera I2S codec negotiates a bogus 64-channel TDM layout, so
# PipeWire's stereo channel map is scrambled (channel 0 reads as silence).
# Capturing mono avoids the bad mapping entirely and is what a single-mic
# satellite wants. soundcard matches exact PulseAudio node names, not the
# 'default' alias. The node names come from WirePlumber with ACP disabled (see
# /etc/wireplumber/main.lua.d/51-lva-codec.lua written by setup-module.sh).
AUDIO_INPUT_DEVICE="alsa_input.platform-sound.capture.0.0"
# mpv's `pulse` output needs the *device* argument to be a PulseAudio device
# name, and the ALSA sink node name is not one: with the bare node name mpv
# fails with `reason=4 ... PlayerState.ERROR` and nothing is heard (this looked
# like another click bug). The `pulse/` prefix selects the pulse output and
# passes the rest through as the device. The INPUT device stays bare because
# LVA's own `soundcard` matcher selects it by exact node name.
AUDIO_OUTPUT_DEVICE="pulse/alsa_output.platform-sound.playback.1.0"
AUDIO_INPUT_CHANNELS=1

# Single mic, no array. MIC_VOLUME is on the upstream 1-100 scale (100 = 1.0).
# Levels are set in hardware by lva-audio-init.service (hardware ALC on), so the
# WebRTC extras are left at upstream defaults; they did not change wake-word
# scores measurably (agc5/ns2 vs off: 0.948 vs 0.942, within run-to-run noise).
MIC_VOLUME=100
MIC_AUTO_GAIN=5
MIC_NOISE_SUPPRESSION=2

# Peripheral API for the LED bridge (same host, loopback).
PERIPHERAL_HOST=127.0.0.1
PERIPHERAL_PORT=6055

# PipeWire/PulseAudio socket for the audio HAL. The module has no normal login
# user, so PipeWire runs in root's user session (UID 0). PULSE_COOKIE is disabled
# because the upstream entrypoint otherwise creates it under /run/user/1000,
# which does not exist on this single-user image.
PULSE_SERVER=/run/user/0/pulse/native
XDG_RUNTIME_DIR=/run/user/0
PULSE_COOKIE=DISABLED

# ESPHome-protocol endpoint HA connects to. This is BOTH the bind address and
# the address put in the mDNS advertisement: LVA passes --host to each, so
# HOST=0.0.0.0 advertises `address = [0.0.0.0]` and HA can never connect. Bind
# the stable alias address from /etc/default/lva-net-alias instead; setup-module.sh
# rewrites this line to the alias it picked, so the value shipped here is a
# placeholder and never survives an install. See docs/bringup.md section 10.
HOST=REPLACED-AT-INSTALL
PORT=6053

# Verbose LVA logging. Worth keeping during bring-up (it shows the wake-word
# probabilities and every mpv command); set to 0 once the box is trusted.
ENABLE_DEBUG=1

REFACTORY_SECONDS=2.0
ENABLE_THINKING_SOUND=1
